#!/usr/bin/env bash
#ddev-generated

## Description: Install or update required skills for MageForge
## Usage: skills
## Example: "ddev skills"

set -uo pipefail

# Determine directory where this script is located (symlink-safe)
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)

# Use $DDEV_APPROOT if available (standard in DDEV), otherwise fallback to /var/www/html
PROJECT_ROOT="${DDEV_APPROOT:-/var/www/html}"
CONFIG_FILE="${PROJECT_ROOT}/.ddev/.env.skills"

# Load config
if [[ ! -f "${CONFIG_FILE}" ]]; then
    echo "❌ .env.skills file not found at ${CONFIG_FILE}"
    exit 1
fi

SKILLS_CONFIG=$(cat "${CONFIG_FILE}")

TARGET_AGENTS=$(grep "^AGENTS=" "${CONFIG_FILE}" | cut -d'=' -f2 | tr -d '"' | tr -d "'" | xargs)
if [[ -z "$TARGET_AGENTS" ]]; then
    TARGET_AGENTS="*"
fi

# Colors for output
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
RED='\033[0;31m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

echo -e "\n${GREEN}OpenForgeProject - Skills Manager${NC}"
echo -e "Target Agent(s): ${YELLOW}$TARGET_AGENTS${NC}"
echo ""

# Suppress npm warnings
export NPM_CONFIG_LOGLEVEL=error

# Determine skills directory location
POSSIBLE_DIRS=(
    "${SCRIPT_DIR}/../../.agents/skills"
    "${PROJECT_ROOT}/.agents/skills"
    "${PWD}/.agents/skills"
)

AGENTS_SKILLS_DIR=""
for dir in "${POSSIBLE_DIRS[@]}"; do
    if [[ -d "$dir" ]]; then
        AGENTS_SKILLS_DIR="$dir"
        break
    fi
done

# Collect installed skills into an associative array for O(1) lookup
declare -A INSTALLED_SKILLS_MAP

if [[ -n "$AGENTS_SKILLS_DIR" ]]; then
    shopt -s nullglob
    for skill_path in "$AGENTS_SKILLS_DIR"/*/; do
        skill_name=$(basename "$skill_path")
        INSTALLED_SKILLS_MAP["$skill_name"]=1
    done
    shopt -u nullglob
fi

INSTALLED_COUNT=0
FAILED_COUNT=0
REMOVED_COUNT=0
declare -A CONFIGURED_SKILLS_MAP

# Process each line from config file
while IFS= read -r line; do
    # Skip empty lines and comments
    [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue

    # Skip AGENTS config line
    [[ "$line" == AGENTS=* ]] && continue

    # Split only on the first '=' to handle URLs with '=' in them
    skill_name="${line%%=*}"
    repo_url="${line#*=}"

    # Remove quotes and whitespace
    skill_name=$(echo "$skill_name" | tr -d '"' | xargs)
    repo_url=$(echo "$repo_url" | tr -d '"' | xargs)

    [[ -z "$skill_name" || -z "$repo_url" ]] && continue

    # Track configured skills so we know what NOT to remove later
    CONFIGURED_SKILLS_MAP["$skill_name"]=1

    # Only run full 'add' if skill is not yet installed
    # This speeds up subsequent runs significantly
    if [[ -z "${INSTALLED_SKILLS_MAP[$skill_name]+_}" ]]; then
        echo -ne "${BLUE}Installing: ${CYAN}$skill_name${NC} "

        # Handle multiple agents (comma or space separated)
        CLEAN_AGENTS=$(echo "$TARGET_AGENTS" | tr ',' ' ')
        SKILL_SUCCESS=1
        ERROR_MSG=""

        for agent in $CLEAN_AGENTS; do
            install_output=$(timeout 60 npx --yes --package skills skills add "$repo_url" --skill "$skill_name" --agent "$agent" -y </dev/null 2>&1)
            install_exit=$?

            if [[ $install_exit -ne 0 ]]; then
                SKILL_SUCCESS=0
                ERROR_MSG="$install_output"
            fi
        done

        if [[ $SKILL_SUCCESS -eq 1 ]]; then
            echo -e "${GREEN}✓${NC}"
            ((INSTALLED_COUNT++))
        else
            echo -e "${RED}✗${NC}"
            echo -e "  ${RED}↳ ${ERROR_MSG}${NC}"
            ((FAILED_COUNT++))
        fi
    fi
done <<< "$SKILLS_CONFIG"
# Check for removed skills (skills installed but no longer in config)
# Handle multiple agents (comma or space separated)
CLEAN_AGENTS=$(echo "$TARGET_AGENTS" | tr ',' ' ')

for installed in "${!INSTALLED_SKILLS_MAP[@]}"; do
    if [[ -z "${CONFIGURED_SKILLS_MAP[$installed]+_}" ]]; then
        echo -ne "${RED}Removing: $installed${NC} "

        SKILL_REMOVED=1
        ERROR_MSG=""

        for agent in $CLEAN_AGENTS; do
            if [[ "$agent" == "*" ]]; then
                 remove_output=$(timeout 60 npx --yes --package skills skills remove "$installed" -y </dev/null 2>&1)
            else
                 remove_output=$(timeout 60 npx --yes --package skills skills remove "$installed" --agent "$agent" -y </dev/null 2>&1)
            fi

            remove_exit=$?
            if [[ $remove_exit -ne 0 ]]; then
                SKILL_REMOVED=0
                ERROR_MSG="$remove_output"
                break
            fi
        done

        if [[ $SKILL_REMOVED -eq 1 ]]; then
            echo -e "${GREEN}✓${NC}"
            ((REMOVED_COUNT++))
        else
            echo -e "${RED}✗${NC}"
            echo -e "  ${RED}↳ ${ERROR_MSG}${NC}"
            ((FAILED_COUNT++))
        fi
    fi
done

echo ""

# Global update if we have skills
if [[ ${#INSTALLED_SKILLS_MAP[@]} -gt 0 || $INSTALLED_COUNT -gt 0 ]]; then
    # Handle multiple agents (comma or space separated)
    CLEAN_AGENTS=$(echo "$TARGET_AGENTS" | tr ',' ' ')

    echo -ne "${YELLOW}Updating All Skills...${NC} "

    UPDATE_FAILED=0
    UPDATE_MSG=""

    for agent in $CLEAN_AGENTS; do
        if [[ "$agent" == "*" ]]; then
             update_output=$(timeout 120 npx --yes --package skills skills update -y </dev/null 2>&1)
        else
             # skills update updates all installed skills for the given agent
             update_output=$(timeout 120 npx --yes --package skills skills update --agent "$agent" -y </dev/null 2>&1)
        fi

        update_exit=$?
        if [[ $update_exit -ne 0 ]]; then
            # Ignore exit code for now as update often returns non-zero if nothing to update or minor issues?
            # Or log it but don't fail the whole script?
            # Let's log failure but continue
            UPDATE_FAILED=1
            UPDATE_MSG="$update_output"
        fi
    done

    if [[ $UPDATE_FAILED -eq 0 ]]; then
        echo -e "${GREEN}✓${NC}\n"
    else
        echo -e "${RED}✗ (Warning only)${NC}\n"
    fi
fi

echo -e "  - Added:     ${GREEN}${INSTALLED_COUNT}${NC}"
echo -e "  - Removed:   ${RED}${REMOVED_COUNT}${NC}"
echo -e "  - Failed:    ${RED}${FAILED_COUNT}${NC}"

if [[ $FAILED_COUNT -gt 0 ]]; then
    echo -e "\n${RED}✗ ${FAILED_COUNT} skill(s) failed. Check output above for details.${NC}"
    exit 1
else
    echo -e "\n${GREEN}✓ Done!${NC}\n"
fi
